{
  "$defs": {
    "ActorKind": {
      "description": "Claude acting through a client, the user directly, or xoot itself.\n\nSYSTEM is for changes xoot derives from another actor's write (a goal or\nbatch completing or reopening, workflow remaps); they keep that write's\nclient.",
      "enum": [
        "claude",
        "user",
        "system"
      ],
      "title": "ActorKind",
      "type": "string"
    },
    "AffectedItemEntry": {
      "description": "The item's state, parent and new version, enough for the next item_update.",
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent"
        },
        "state": {
          "title": "State",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "key",
        "state",
        "parent",
        "version"
      ],
      "title": "AffectedItemEntry",
      "type": "object"
    },
    "BacklogRow": {
      "description": "The backlog entry plus when the item was created and why it was\ncaptured: the first line of its body, cut to WHY_MAX characters.",
      "properties": {
        "category": {
          "anyOf": [
            {
              "$ref": "#/$defs/Category"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "found_on": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Found On"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ItemKind"
        },
        "level": {
          "enum": [
            "project",
            "goal",
            "batch"
          ],
          "title": "Level",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent"
        },
        "state": {
          "title": "State",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        },
        "why": {
          "title": "Why",
          "type": "string"
        }
      },
      "required": [
        "key",
        "kind",
        "title",
        "state",
        "category",
        "parent",
        "version",
        "level",
        "found_on",
        "created_at",
        "why"
      ],
      "title": "BacklogRow",
      "type": "object"
    },
    "BacklogView": {
      "description": "Open backlog items of every level, project level first, then by key;\ntruncated when the cap hid items.",
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/BacklogRow"
          },
          "title": "Items",
          "type": "array"
        },
        "project": {
          "title": "Project",
          "type": "string"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "project",
        "items",
        "truncated"
      ],
      "title": "BacklogView",
      "type": "object"
    },
    "BlockedEntry": {
      "description": "Every child is done or dropped, but open_backlog backlog items still sit\non it: cover them, resolve them (item_update to done) or push them up.",
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "open_backlog": {
          "title": "Open Backlog",
          "type": "integer"
        }
      },
      "required": [
        "key",
        "open_backlog"
      ],
      "title": "BlockedEntry",
      "type": "object"
    },
    "BriefView": {
      "description": "The brief_get picture without its MCP-only fields: counts, open goals\nwith batch progress, work in flight, what open backlog blocks, open\nbacklog per level, recent decisions and the workflow.",
      "properties": {
        "active": {
          "items": {
            "$ref": "#/$defs/ItemSummary"
          },
          "title": "Active",
          "type": "array"
        },
        "awaiting_input": {
          "items": {
            "$ref": "#/$defs/ItemSummary"
          },
          "title": "Awaiting Input",
          "type": "array"
        },
        "backlog_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "enum": [
              "project",
              "goal",
              "batch"
            ]
          },
          "title": "Backlog Counts",
          "type": "object"
        },
        "blocked": {
          "items": {
            "$ref": "#/$defs/BlockedEntry"
          },
          "title": "Blocked",
          "type": "array"
        },
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "#/$defs/Category"
          },
          "title": "Counts",
          "type": "object"
        },
        "open_goals": {
          "items": {
            "$ref": "#/$defs/GoalProgressEntry"
          },
          "title": "Open Goals",
          "type": "array"
        },
        "open_goals_truncated": {
          "title": "Open Goals Truncated",
          "type": "boolean"
        },
        "project": {
          "$ref": "#/$defs/ProjectInfo"
        },
        "recent_decisions": {
          "items": {
            "$ref": "#/$defs/DecisionSummary"
          },
          "title": "Recent Decisions",
          "type": "array"
        },
        "workflow": {
          "additionalProperties": {
            "$ref": "#/$defs/WorkflowEntry"
          },
          "propertyNames": {
            "$ref": "#/$defs/ItemKind"
          },
          "title": "Workflow",
          "type": "object"
        }
      },
      "required": [
        "project",
        "workflow",
        "open_goals",
        "open_goals_truncated",
        "blocked",
        "backlog_counts",
        "counts",
        "active",
        "awaiting_input",
        "recent_decisions"
      ],
      "title": "BriefView",
      "type": "object"
    },
    "CaptureRequest": {
      "additionalProperties": false,
      "description": "Open work found on an item, with a body saying why it needs doing.",
      "properties": {
        "body": {
          "maxLength": 32768,
          "title": "Body",
          "type": "string"
        },
        "found_on": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Found On",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "found_on",
        "title",
        "body"
      ],
      "title": "CaptureRequest",
      "type": "object"
    },
    "Category": {
      "description": "The fixed set of categories. Project workflows name their own states,\nbut every state belongs to exactly one of these, and domain rules\n(completion, backlog counts, tree filtering) reason only in categories.\nBacklog is an item kind, not a category.",
      "enum": [
        "open",
        "active",
        "blocked",
        "awaiting_input",
        "done",
        "dropped"
      ],
      "title": "Category",
      "type": "string"
    },
    "ChangeEntry": {
      "description": "The item key and its changed fields, old and new, with keys for\nreferences; a move includes the number the item takes.",
      "properties": {
        "after": {
          "additionalProperties": true,
          "title": "After",
          "type": "object"
        },
        "before": {
          "additionalProperties": true,
          "title": "Before",
          "type": "object"
        },
        "key": {
          "title": "Key",
          "type": "string"
        }
      },
      "required": [
        "key",
        "before",
        "after"
      ],
      "title": "ChangeEntry",
      "type": "object"
    },
    "ChangesView": {
      "description": "The project's newest event id; the dashboard polls it for changes.",
      "properties": {
        "latest_event_id": {
          "title": "Latest Event Id",
          "type": "integer"
        }
      },
      "required": [
        "latest_event_id"
      ],
      "title": "ChangesView",
      "type": "object"
    },
    "ChildrenSummary": {
      "description": "How many children there are per category, and the first few of them.",
      "properties": {
        "by_category": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "#/$defs/Category"
          },
          "title": "By Category",
          "type": "object"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/ItemSummary"
          },
          "title": "Items",
          "type": "array"
        },
        "total": {
          "title": "Total",
          "type": "integer"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "total",
        "by_category",
        "items",
        "truncated"
      ],
      "title": "ChildrenSummary",
      "type": "object"
    },
    "Client": {
      "description": "Where a write came from; recorded on every event.",
      "enum": [
        "chat",
        "code",
        "paste",
        "cli",
        "dashboard"
      ],
      "title": "Client",
      "type": "string"
    },
    "CoverOutput": {
      "description": "The new subtask, the backlog item it closed, and the engine's outcome.",
      "properties": {
        "backlog": {
          "$ref": "#/$defs/ItemSummary"
        },
        "blocked": {
          "items": {
            "$ref": "#/$defs/BlockedEntry"
          },
          "title": "Blocked",
          "type": "array"
        },
        "changed": {
          "items": {
            "$ref": "#/$defs/VersionEntry"
          },
          "title": "Changed",
          "type": "array"
        },
        "completed": {
          "items": {
            "type": "string"
          },
          "title": "Completed",
          "type": "array"
        },
        "project": {
          "title": "Project",
          "type": "string"
        },
        "reopened": {
          "items": {
            "type": "string"
          },
          "title": "Reopened",
          "type": "array"
        },
        "subtask": {
          "$ref": "#/$defs/ItemDetail"
        }
      },
      "required": [
        "project",
        "subtask",
        "backlog"
      ],
      "title": "CoverOutput",
      "type": "object"
    },
    "CoverRequest": {
      "additionalProperties": false,
      "description": "Turn a backlog item into a subtask and close it. A goal-level item needs\nthe batch to cover it in; a batch-level one is covered in its own batch.",
      "properties": {
        "batch": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Batch"
        },
        "key": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        }
      },
      "required": [
        "key"
      ],
      "title": "CoverRequest",
      "type": "object"
    },
    "DecisionCreateRequest": {
      "additionalProperties": false,
      "description": "A decision on the goal, batch or subtask it was made on; supersedes names\nan older decision of the same goal, which becomes superseded.",
      "properties": {
        "body": {
          "default": "",
          "maxLength": 32768,
          "title": "Body",
          "type": "string"
        },
        "owner": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Owner",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/DecisionStatus",
          "default": "locked"
        },
        "supersedes": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "owner",
        "title"
      ],
      "title": "DecisionCreateRequest",
      "type": "object"
    },
    "DecisionDetail": {
      "description": "The summary plus the body and creation time.",
      "properties": {
        "body": {
          "title": "Body",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "owner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Owner"
        },
        "status": {
          "$ref": "#/$defs/DecisionStatus"
        },
        "supersedes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Supersedes"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "updated_at": {
          "title": "Updated At",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "key",
        "title",
        "status",
        "owner",
        "supersedes",
        "version",
        "updated_at",
        "body",
        "created_at"
      ],
      "title": "DecisionDetail",
      "type": "object"
    },
    "DecisionOutput": {
      "description": "One decision in full, and the project it belongs to.",
      "properties": {
        "decision": {
          "$ref": "#/$defs/DecisionDetail"
        },
        "project": {
          "title": "Project",
          "type": "string"
        }
      },
      "required": [
        "project",
        "decision"
      ],
      "title": "DecisionOutput",
      "type": "object"
    },
    "DecisionStatus": {
      "description": "Superseded is terminal and only reached by a newer decision.",
      "enum": [
        "locked",
        "deferred",
        "superseded"
      ],
      "title": "DecisionStatus",
      "type": "string"
    },
    "DecisionSummary": {
      "description": "A decision's key (<owner key>/decision-<n>), title, status, the item it\nwas made on, the decision it supersedes, and its version.",
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "owner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Owner"
        },
        "status": {
          "$ref": "#/$defs/DecisionStatus"
        },
        "supersedes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Supersedes"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "updated_at": {
          "title": "Updated At",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "key",
        "title",
        "status",
        "owner",
        "supersedes",
        "version",
        "updated_at"
      ],
      "title": "DecisionSummary",
      "type": "object"
    },
    "DecisionUpdateRequest": {
      "additionalProperties": false,
      "description": "New title, body or status of a decision, based on expected_version.",
      "properties": {
        "body": {
          "anyOf": [
            {
              "maxLength": 32768,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Body"
        },
        "expected_version": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Expected Version",
          "type": "integer"
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/DecisionStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "required": [
        "expected_version"
      ],
      "title": "DecisionUpdateRequest",
      "type": "object"
    },
    "DecisionView": {
      "description": "One decision with its body.",
      "properties": {
        "decision": {
          "$ref": "#/$defs/DecisionDetail"
        }
      },
      "required": [
        "decision"
      ],
      "title": "DecisionView",
      "type": "object"
    },
    "DecisionsView": {
      "description": "Decisions, newest first.",
      "properties": {
        "decisions": {
          "items": {
            "$ref": "#/$defs/DecisionSummary"
          },
          "title": "Decisions",
          "type": "array"
        },
        "project": {
          "title": "Project",
          "type": "string"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "project",
        "decisions",
        "truncated"
      ],
      "title": "DecisionsView",
      "type": "object"
    },
    "ErrorOutput": {
      "description": "The error class name and a safe message, built by the same rules as MCP\ntool errors: never driver text, SQL or an arbitrary input value.",
      "properties": {
        "error": {
          "title": "Error",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "error",
        "message"
      ],
      "title": "ErrorOutput",
      "type": "object"
    },
    "EventAction": {
      "description": "The kind of mutation an event row describes.",
      "enum": [
        "create",
        "update",
        "add_alias",
        "add_path",
        "remove_alias",
        "remove_path",
        "redact"
      ],
      "title": "EventAction",
      "type": "string"
    },
    "EventEntry": {
      "description": "Who changed what and when. changed names every changed field, body\nincluded; before/after hold the non-body values, with keys for references.",
      "properties": {
        "action": {
          "$ref": "#/$defs/EventAction"
        },
        "actor_kind": {
          "$ref": "#/$defs/ActorKind"
        },
        "after": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "After"
        },
        "before": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Before"
        },
        "changed": {
          "items": {
            "type": "string"
          },
          "title": "Changed",
          "type": "array"
        },
        "client": {
          "$ref": "#/$defs/Client"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "redacted": {
          "title": "Redacted",
          "type": "boolean"
        }
      },
      "required": [
        "action",
        "actor_kind",
        "client",
        "created_at",
        "redacted",
        "changed",
        "before",
        "after"
      ],
      "title": "EventEntry",
      "type": "object"
    },
    "GoalProgressEntry": {
      "description": "batches_done of batches_total are done (dropped batches count in\nneither); open_backlog counts the open backlog anywhere in the goal.",
      "properties": {
        "batches_done": {
          "title": "Batches Done",
          "type": "integer"
        },
        "batches_total": {
          "title": "Batches Total",
          "type": "integer"
        },
        "category": {
          "anyOf": [
            {
              "$ref": "#/$defs/Category"
            },
            {
              "type": "null"
            }
          ]
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "open_backlog": {
          "title": "Open Backlog",
          "type": "integer"
        },
        "state": {
          "title": "State",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "key",
        "title",
        "state",
        "category",
        "batches_done",
        "batches_total",
        "open_backlog",
        "version"
      ],
      "title": "GoalProgressEntry",
      "type": "object"
    },
    "ItemCreateRequest": {
      "additionalProperties": false,
      "description": "A new goal, batch or subtask. A goal takes no parent, a batch a goal and\na subtask a batch; backlog items come from capture.",
      "properties": {
        "body": {
          "default": "",
          "maxLength": 32768,
          "title": "Body",
          "type": "string"
        },
        "kind": {
          "enum": [
            "goal",
            "batch",
            "subtask"
          ],
          "title": "Kind",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "title"
      ],
      "title": "ItemCreateRequest",
      "type": "object"
    },
    "ItemDetail": {
      "description": "The summary plus the body, the awaited decision, the backlog links\n(found_on and covered_by on a backlog item, origin on a subtask made\nfrom one), every older key that still resolves to it, and timestamps.",
      "properties": {
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "awaiting_decision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Awaiting Decision"
        },
        "body": {
          "title": "Body",
          "type": "string"
        },
        "category": {
          "anyOf": [
            {
              "$ref": "#/$defs/Category"
            },
            {
              "type": "null"
            }
          ]
        },
        "covered_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Covered By"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "found_on": {
