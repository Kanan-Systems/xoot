{
  "$defs": {
    "ActorKind": {
      "description": "Claude acting through a client, the user directly, or xoot itself.\n\nSYSTEM is for changes xoot derives from another actor's write (a goal or\nbatch completing or reopening, workflow remaps); they keep that write's\nclient.",
      "enum": [
        "claude",
        "user",
        "system"
      ],
      "title": "ActorKind",
      "type": "string"
    },
    "BacklogRow": {
      "description": "The backlog entry plus when the item was created and why it was\ncaptured: the first line of its body, cut to WHY_MAX characters.",
      "properties": {
        "category": {
          "anyOf": [
            {
              "$ref": "#/$defs/Category"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "found_on": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Found On"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ItemKind"
        },
        "level": {
          "enum": [
            "project",
            "goal",
            "batch"
          ],
          "title": "Level",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent"
        },
        "state": {
          "title": "State",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        },
        "why": {
          "title": "Why",
          "type": "string"
        }
      },
      "required": [
        "key",
        "kind",
        "title",
        "state",
        "category",
        "parent",
        "version",
        "level",
        "found_on",
        "created_at",
        "why"
      ],
      "title": "BacklogRow",
      "type": "object"
    },
    "BacklogView": {
      "description": "Open backlog items of every level, project level first, then by key;\ntruncated when the cap hid items.",
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/BacklogRow"
          },
          "title": "Items",
          "type": "array"
        },
        "project": {
          "title": "Project",
          "type": "string"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "project",
        "items",
        "truncated"
      ],
      "title": "BacklogView",
      "type": "object"
    },
    "BlockedEntry": {
      "description": "Every child is done or dropped, but open_backlog backlog items still sit\non it: cover them, resolve them (item_update to done) or push them up.",
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "open_backlog": {
          "title": "Open Backlog",
          "type": "integer"
        }
      },
      "required": [
        "key",
        "open_backlog"
      ],
      "title": "BlockedEntry",
      "type": "object"
    },
    "BriefView": {
      "description": "The brief_get picture without its MCP-only fields: counts, open goals\nwith batch progress, work in flight, what open backlog blocks, open\nbacklog per level, recent decisions and the workflow.",
      "properties": {
        "active": {
          "items": {
            "$ref": "#/$defs/ItemSummary"
          },
          "title": "Active",
          "type": "array"
        },
        "awaiting_input": {
          "items": {
            "$ref": "#/$defs/ItemSummary"
          },
          "title": "Awaiting Input",
          "type": "array"
        },
        "backlog_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "enum": [
              "project",
              "goal",
              "batch"
            ]
          },
          "title": "Backlog Counts",
          "type": "object"
        },
        "blocked": {
          "items": {
            "$ref": "#/$defs/BlockedEntry"
          },
          "title": "Blocked",
          "type": "array"
        },
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "#/$defs/Category"
          },
          "title": "Counts",
          "type": "object"
        },
        "open_goals": {
          "items": {
            "$ref": "#/$defs/GoalProgressEntry"
          },
          "title": "Open Goals",
          "type": "array"
        },
        "open_goals_truncated": {
          "title": "Open Goals Truncated",
          "type": "boolean"
        },
        "project": {
          "$ref": "#/$defs/ProjectInfo"
        },
        "recent_decisions": {
          "items": {
            "$ref": "#/$defs/DecisionSummary"
          },
          "title": "Recent Decisions",
          "type": "array"
        },
        "workflow": {
          "additionalProperties": {
            "$ref": "#/$defs/WorkflowEntry"
          },
          "propertyNames": {
            "$ref": "#/$defs/ItemKind"
          },
          "title": "Workflow",
          "type": "object"
        }
      },
      "required": [
        "project",
        "workflow",
        "open_goals",
        "open_goals_truncated",
        "blocked",
        "backlog_counts",
        "counts",
        "active",
        "awaiting_input",
        "recent_decisions"
      ],
      "title": "BriefView",
      "type": "object"
    },
    "Category": {
      "description": "The fixed set of categories. Project workflows name their own states,\nbut every state belongs to exactly one of these, and domain rules\n(completion, backlog counts, tree filtering) reason only in categories.\nBacklog is an item kind, not a category.",
      "enum": [
        "open",
        "active",
        "blocked",
        "awaiting_input",
        "done",
        "dropped"
      ],
      "title": "Category",
      "type": "string"
    },
    "ChangesView": {
      "description": "The project's newest event id; the dashboard polls it for changes.",
      "properties": {
        "latest_event_id": {
          "title": "Latest Event Id",
          "type": "integer"
        }
      },
      "required": [
        "latest_event_id"
      ],
      "title": "ChangesView",
      "type": "object"
    },
    "ChildrenSummary": {
      "description": "How many children there are per category, and the first few of them.",
      "properties": {
        "by_category": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "#/$defs/Category"
          },
          "title": "By Category",
          "type": "object"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/ItemSummary"
          },
          "title": "Items",
          "type": "array"
        },
        "total": {
          "title": "Total",
          "type": "integer"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "total",
        "by_category",
        "items",
        "truncated"
      ],
      "title": "ChildrenSummary",
      "type": "object"
    },
    "Client": {
      "description": "Where a write came from; recorded on every event.",
      "enum": [
        "chat",
        "code",
        "paste",
        "cli"
      ],
      "title": "Client",
      "type": "string"
    },
    "DecisionDetail": {
      "description": "The summary plus the body and creation time.",
      "properties": {
        "body": {
          "title": "Body",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "owner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Owner"
        },
        "status": {
          "$ref": "#/$defs/DecisionStatus"
        },
        "supersedes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Supersedes"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "updated_at": {
          "title": "Updated At",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "key",
        "title",
        "status",
        "owner",
        "supersedes",
        "version",
        "updated_at",
        "body",
        "created_at"
      ],
      "title": "DecisionDetail",
      "type": "object"
    },
    "DecisionStatus": {
      "description": "Superseded is terminal and only reached by a newer decision.",
      "enum": [
        "locked",
        "deferred",
        "superseded"
      ],
      "title": "DecisionStatus",
      "type": "string"
    },
    "DecisionSummary": {
      "description": "A decision's key (<owner key>/decision-<n>), title, status, the item it\nwas made on, the decision it supersedes, and its version.",
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "owner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Owner"
        },
        "status": {
          "$ref": "#/$defs/DecisionStatus"
        },
        "supersedes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Supersedes"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "updated_at": {
          "title": "Updated At",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "key",
        "title",
        "status",
        "owner",
        "supersedes",
        "version",
        "updated_at"
      ],
      "title": "DecisionSummary",
      "type": "object"
    },
    "DecisionView": {
      "description": "One decision with its body.",
      "properties": {
        "decision": {
          "$ref": "#/$defs/DecisionDetail"
        }
      },
      "required": [
        "decision"
      ],
      "title": "DecisionView",
      "type": "object"
    },
    "DecisionsView": {
      "description": "Decisions, newest first.",
      "properties": {
        "decisions": {
          "items": {
            "$ref": "#/$defs/DecisionSummary"
          },
          "title": "Decisions",
          "type": "array"
        },
        "project": {
          "title": "Project",
          "type": "string"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "project",
        "decisions",
        "truncated"
      ],
      "title": "DecisionsView",
      "type": "object"
    },
    "ErrorOutput": {
      "description": "The error class name and a safe message, built by the same rules as MCP\ntool errors: never driver text, SQL or an arbitrary input value.",
      "properties": {
        "error": {
          "title": "Error",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "error",
        "message"
      ],
      "title": "ErrorOutput",
      "type": "object"
    },
    "EventAction": {
      "description": "The kind of mutation an event row describes.",
      "enum": [
        "create",
        "update",
        "add_alias",
        "add_path",
        "remove_alias",
        "remove_path",
        "redact"
      ],
      "title": "EventAction",
      "type": "string"
    },
    "EventEntry": {
      "description": "Who changed what and when. changed names every changed field, body\nincluded; before/after hold the non-body values, with keys for references.",
      "properties": {
        "action": {
          "$ref": "#/$defs/EventAction"
        },
        "actor_kind": {
          "$ref": "#/$defs/ActorKind"
        },
        "after": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "After"
        },
        "before": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Before"
        },
        "changed": {
          "items": {
            "type": "string"
          },
          "title": "Changed",
          "type": "array"
        },
        "client": {
          "$ref": "#/$defs/Client"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "redacted": {
          "title": "Redacted",
          "type": "boolean"
        }
      },
      "required": [
        "action",
        "actor_kind",
        "client",
        "created_at",
        "redacted",
        "changed",
        "before",
        "after"
      ],
      "title": "EventEntry",
      "type": "object"
    },
    "GoalProgressEntry": {
      "description": "batches_done of batches_total are done (dropped batches count in\nneither); open_backlog counts the open backlog anywhere in the goal.",
      "properties": {
        "batches_done": {
          "title": "Batches Done",
          "type": "integer"
        },
        "batches_total": {
          "title": "Batches Total",
          "type": "integer"
        },
        "category": {
          "anyOf": [
            {
              "$ref": "#/$defs/Category"
            },
            {
              "type": "null"
            }
          ]
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "open_backlog": {
          "title": "Open Backlog",
          "type": "integer"
        },
        "state": {
          "title": "State",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "key",
        "title",
        "state",
        "category",
        "batches_done",
        "batches_total",
        "open_backlog",
        "version"
      ],
      "title": "GoalProgressEntry",
      "type": "object"
    },
    "ItemDetail": {
      "description": "The summary plus the body, the awaited decision, the backlog links\n(found_on and covered_by on a backlog item, origin on a subtask made\nfrom one), every older key that still resolves to it, and timestamps.",
      "properties": {
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "awaiting_decision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Awaiting Decision"
        },
        "body": {
          "title": "Body",
          "type": "string"
        },
        "category": {
          "anyOf": [
            {
              "$ref": "#/$defs/Category"
            },
            {
              "type": "null"
            }
          ]
        },
        "covered_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Covered By"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "found_on": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Found On"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ItemKind"
        },
        "origin": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Origin"
        },
        "parent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent"
        },
        "state": {
          "title": "State",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "updated_at": {
          "title": "Updated At",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "key",
        "kind",
        "title",
        "state",
        "category",
        "parent",
        "version",
        "body",
        "awaiting_decision",
        "found_on",
        "covered_by",
        "origin",
        "aliases",
        "created_at",
        "updated_at"
      ],
      "title": "ItemDetail",
      "type": "object"
    },
    "ItemKind": {
      "description": "A goal holds batches, a batch holds subtasks. A backlog item is open work\nfound along the way; it sits on a batch, a goal or the project.",
      "enum": [
        "goal",
        "batch",
        "subtask",
        "backlog"
      ],
      "title": "ItemKind",
      "type": "string"
    },
    "ItemSummary": {
      "description": "Enough to recognize, pick and update an item. key is its nested path\nwithin the project; category is the fixed meaning of the\nproject-defined state; version is what item_update needs.",
      "properties": {
        "category": {
          "anyOf": [
            {
              "$ref": "#/$defs/Category"
            },
            {
              "type": "null"
            }
          ]
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ItemKind"
        },
        "parent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent"
        },
        "state": {
          "title": "State",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "key",
        "kind",
        "title",
        "state",
        "category",
        "parent",
        "version"
      ],
      "title": "ItemSummary",
      "type": "object"
    },
    "ItemView": {
      "description": "One item in full: its children (work first, then backlog), its most\nrecent events (newest first) and the decisions made on it, with bodies.",
      "properties": {
        "children": {
          "$ref": "#/$defs/ChildrenSummary"
        },
        "decisions": {
          "items": {
            "$ref": "#/$defs/DecisionDetail"
          },
          "title": "Decisions",
          "type": "array"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/EventEntry"
          },
          "title": "Events",
          "type": "array"
        },
        "item": {
          "$ref": "#/$defs/ItemDetail"
        }
      },
      "required": [
        "item",
        "children",
        "events",
        "decisions"
      ],
      "title": "ItemView",
      "type": "object"
    },
    "MetaOutput": {
      "description": "The running xoot version.",
      "properties": {
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version"
      ],
      "title": "MetaOutput",
      "type": "object"
    },
    "ProjectInfo": {
      "description": "The key prefix the URLs use, the display name and the aliases.\nRegistered paths are left out: the browser has no use for local paths.",
      "properties": {
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "key_prefix": {
          "title": "Key Prefix",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "key_prefix",
        "name",
        "aliases"
      ],
      "title": "ProjectInfo",
      "type": "object"
    },
    "ProjectsOutput": {
      "description": "Every registered project, by key prefix.",
      "properties": {
        "projects": {
          "items": {
            "$ref": "#/$defs/ProjectInfo"
          },
          "title": "Projects",
          "type": "array"
        }
      },
      "required": [
        "projects"
      ],
      "title": "ProjectsOutput",
      "type": "object"
    },
    "StateSpec": {
      "additionalProperties": false,
      "description": "A project-chosen state name and the fixed category it belongs to.",
      "properties": {
        "category": {
          "$ref": "#/$defs/Category"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_-]{0,31}$",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "category"
      ],
      "title": "StateSpec",
      "type": "object"
    },
    "TreeEntry": {
      "description": "An item and its depth below the query's roots.",
      "properties": {
        "depth": {
          "title": "Depth",
          "type": "integer"
        },
        "item": {
          "$ref": "#/$defs/ItemSummary"
        }
      },
      "required": [
        "depth",
        "item"
      ],
      "title": "TreeEntry",
      "type": "object"
    },
    "TreeView": {
      "description": "Tree nodes in pre-order; truncated says the bounds hid items. blocked\nlists every goal and batch of the project that open backlog holds open,\nuncapped, so any node can show it.",
      "properties": {
        "blocked": {
          "items": {
            "$ref": "#/$defs/BlockedEntry"
          },
          "title": "Blocked",
          "type": "array"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/TreeEntry"
          },
          "title": "Nodes",
          "type": "array"
        },
        "project": {
          "title": "Project",
          "type": "string"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "project",
        "nodes",
        "truncated",
        "blocked"
      ],
      "title": "TreeView",
      "type": "object"
    },
    "WorkflowEntry": {
      "description": "Every state of one kind with its category, so a client picks real state\nnames, and whether only listed transitions are allowed.",
      "properties": {
        "states": {
          "items": {
            "$ref": "#/$defs/StateSpec"
          },
          "title": "States",
          "type": "array"
        },
        "transitions_restricted": {
          "title": "Transitions Restricted",
          "type": "boolean"
        }
      },
      "required": [
        "states",
        "transitions_restricted"
      ],
      "title": "WorkflowEntry",
      "type": "object"
    }
  },
  "title": "XootDashboardApi"
}
