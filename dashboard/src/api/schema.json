    "ItemUpdateRequest": {
      "additionalProperties": false,
      "description": "New title, body or state, based on expected_version. Dropping an item that\nhas children first returns a preview and a confirm_token; send the state\nalone, then the same body plus the token.",
      "properties": {
        "body": {
          "anyOf": [
            {
              "maxLength": 32768,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Body"
        },
        "confirm_token": {
          "anyOf": [
            {
              "maxLength": 128,
